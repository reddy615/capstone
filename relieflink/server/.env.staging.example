NODE_ENV=staging
STAGING_MONGODB_URI=mongodb+srv://<dedicated-staging-user>:<password>@<staging-cluster>.mongodb.net/relieflink_staging?retryWrites=true&w=majority
JWT_SECRET=<new-random-staging-only-secret>
JWT_EXPIRES_IN=7d
PORT=5000
